---
// Carte-lien de l’accueil. Au survol, le curseur texte affiche « En savoir plus » (src/scripts/cursor.ts).
import type { Insight } from '../data/insights';

type Props = Omit<Insight, 'gridId'>;

const { href, image, category, date, title, excerpt, balanceTitle = false } = Astro.props;
---

<a href={href} data-cursor-text="En savoir plus" data-cursor-hover="" class="blog_item is_link">
  <div class="blog_item-img">
    <img src={image.src} loading="lazy" sizes={image.sizes} srcset={image.srcset} alt={image.alt} class="img-cover" />
  </div>
  <div class="blog_item-content">
    <div class="blog_item-tag-wrap">
      <div class="blog_item-tag">{category}</div>
      <div class="blog_item-tag">{date}</div>
    </div>
    <h3 class:list={['heading-size-h5', { 'text-wrap-balance': balanceTitle }]}>{title}</h3>
    <p class="text-color_white">{excerpt}</p>
  </div>
</a>

<style>
  .is_link {
    color: inherit;
    text-decoration: none;
  }
</style>
