---
// Key figures with the number odometer (src/scripts/odometer.ts).
import StatRow from '../../StatRow.astro';
import { stats } from '../../../data/stats';
import '../../../styles/odometer.css';
---

<section data-bg-section="light" data-theme-section="light" class="section">
  <div class="container">
    <div class="layout-grid grid_12-col">
      <div id="g-09" class="grid_column">
        <div class="bolt"></div>
      </div>
      <div id="g-10" class="grid_column">
        <div class="service_item-list">
          {stats.map((stat) => (
            <StatRow {...stat} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../../scripts/odometer';
</script>
