---
// À propos : profils recherchés (aucun visage) et appel aux candidats.
import TeamCard from '../../TeamCard.astro';
import { team } from '../../../data/team';
import { site } from '../../../config/site';
---

<section data-bg-section="light" data-theme-section="light" class="section">
  <div class="container">
    <div class="grid_12-col is_team">
      {team.map((member) => (
        <TeamCard {...member} />
      ))}
      <div id="g-13" class="team_item">
        <div class="team_item-cta">
          <h4>Envie de travailler avec nous?</h4>
          <div class="team_item-placeholder"></div>
          <div id="g-14" class="vertical_flex gap-2">
            <p>
              Vous êtes infirmière, infirmière auxiliaire, préposé(e) aux bénéficiaires ou chauffeur? Appelez-nous.
              Postuler est gratuit, du début à la fin.
            </p>
            <div class="footer_l_ink-wrap">
              <a href={site.phone.href} class="footer__link link-block">
                <span data-button-animate-chars="" class="footer__link-txt">
                  {site.phone.display}
                </span>
              </a>
              <div class="footer__link-underline"></div>
            </div>
          </div>
          <svg
            id="g-15"
            xmlns="http://www.w3.org/2000/svg"
            width="100%"
            viewBox="0 0 100.00 72.65"
            fill="none"
            aria-hidden="true"
            class="team_item-signet"
          >
            <path
              d="M26.69 0.00 29.89 0.00 32.99 0.47 34.96 1.03 37.59 2.26 39.94 3.95 41.82 5.92 43.33 8.18 44.55 11.00 45.30 13.82 45.77 17.48 45.86 54.98 46.33 56.86 47.46 57.80 48.59 57.80 49.25 57.52 50.19 56.48 51.03 54.61 62.41 15.41 63.53 12.22 64.94 9.21 67.11 6.11 69.92 3.48 72.93 1.69 76.60 0.47 79.79 0.00 83.93 0.09 87.50 0.85 91.17 2.44 93.52 4.14 96.05 6.86 97.93 10.15 99.15 13.82 99.81 18.14 99.91 72.46 84.02 72.46 83.93 16.64 83.36 14.57 82.71 13.63 81.58 12.78 80.36 12.59 79.14 12.78 78.29 13.35 77.16 14.57 76.41 16.07 64.47 56.20 62.97 60.62 61.65 63.44 59.59 66.54 57.05 68.98 55.45 70.02 53.38 70.96 49.91 71.71 46.80 71.71 44.55 71.33 42.48 70.68 39.94 69.36 38.06 67.95 36.28 66.17 34.96 64.38 33.55 61.75 32.24 57.42 31.67 52.07 31.67 16.82 30.73 13.91 29.42 12.78 27.16 12.78 26.22 13.35 24.72 15.79 23.59 20.30 20.86 36.94 20.68 37.12 19.55 44.92 19.36 45.11 17.48 57.52 17.29 57.71 15.04 72.46 0.09 72.56 2.16 57.80 7.14 26.03 8.55 18.52 10.24 12.59 11.47 9.87 12.88 7.61 14.38 5.73 16.54 3.76 18.52 2.44 21.33 1.13 25.00 0.19 26.60 0.09Z"
              fill="#00269b"
            ></path>
          </svg>
        </div>
        <div class="team_item-bottom">
          <div class="team_item-text">
            <p></p>
          </div>
          <div class="bolt"></div>
        </div>
      </div>
    </div>
  </div>
</section>
