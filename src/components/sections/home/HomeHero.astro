---
// Accueil : « Du personnel qualifié. Au bon moment. » autour de la photo, puis les quatre services.
---

<section data-theme-section="light" class="section is_hero">
  <div class="hero_spacer"></div>
  <div class="container">
    <div class="hero_layout">
      <div class="hero_heading-wrap">
        <h1 class="hero_heading">Du</h1>
        <h1 class="hero_heading">personnel</h1>
        <h1 class="hero_heading">qualifié.</h1>
      </div>
      <div class="hero_img-layout">
        <div class="hero_img-wrap">
          <div class="hero_img">
            <img
              class="img-cover"
              src="/images/medica-hero.avif"
              alt="Une infirmière en sarrau, bras croisés, devant le M de Médica Placement."
              sizes="(max-width: 991px) 90vw, 32em"
              loading="eager"
              fetchpriority="high"
              data-animate="hero-img"
              srcset="/images/medica-hero-p-500.avif 500w, /images/medica-hero-p-800.avif 800w, /images/medica-hero-p-1080.avif 1080w, /images/medica-hero.avif 1185w"
            />
          </div>
        </div>
      </div>
      <div class="hero_heading-wrap">
        <h1 class="hero_heading is_second">Au</h1>
        <h1 class="hero_heading is_second">bon</h1>
        <h1 class="hero_heading is_second">moment.</h1>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="hero_bottom">
      <div class="hero_bottom-txt">Recrutement</div>
      <div class="hero_bottom-txt">Placement</div>
      <div class="hero_bottom-txt">Logistique</div>
      <div class="hero_bottom-txt">Répartition</div>
    </div>
  </div>
</section>
