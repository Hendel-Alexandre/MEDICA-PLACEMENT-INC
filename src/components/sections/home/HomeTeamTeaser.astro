---
// Bandeau plein écran : service 24/7.
import ParallaxSection from '../../ParallaxSection.astro';
import { photo } from '../../../data/photos';
---

<ParallaxSection image={photo('phone-call', 'Une professionnelle de la santé tient un téléphone.')}>
  <div class="horizontal_flex-between">
    <div class="max-width-100">
      <h2 data-animate="typo" class="heading-size-h2">
        Besoin de quelqu’un ce soir? Nous répondons jour et nuit.
      </h2>
    </div>
    <div class="footer_l_ink-wrap">
      <a href="/contact" class="footer__link link-block">
        <span data-button-animate-chars="" class="footer__link-txt">
          Nous joindre
        </span>
      </a>
      <div class="footer__link-underline is_light"></div>
    </div>
  </div>
</ParallaxSection>
