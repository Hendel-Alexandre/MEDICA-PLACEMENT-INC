---
// Numbered process steps.
import ProcessStep from '../../ProcessStep.astro';
import { processSteps } from '../../../data/process';
---

<section data-bg-section="light" data-theme-section="light" class="section">
  <div class="container">
    <div class="grid_12-col">
      <div id="w-node-a656f15f-7a59-bd1d-9a1a-233f5af01541-9fc0289c" class="grid_column">
        <div class="bolt"></div>
      </div>
      <div id="w-node-a656f15f-7a59-bd1d-9a1a-233f5af01543-9fc0289c" class="grid_column">
        <div class="service_item-list">
          {processSteps.map((step) => (
            <ProcessStep {...step} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
