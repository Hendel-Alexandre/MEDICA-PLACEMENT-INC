---
// Bandeau : les milieux où nous travaillons, en mots qui défilent (src/scripts/rotating-text.ts).
import '../../../styles/rotating-text.css';
import ParallaxSection from '../../ParallaxSection.astro';
import { photo } from '../../../data/photos';
---

<ParallaxSection middle overlay="full" image={photo('care-knitting', '')}>
  <Fragment slot="middle">
    <div class="layout-grid grid_12-col">
      <div id="g-24" class="grid_column">
        <h2 data-rotating-title="" class="heading-size-h4">
          Nous travaillons avec :{' '}
          <span
            data-rotating-words="Hôpitaux, CISSS et CIUSSS, CHSLD publics, CHSLD privés, Résidences pour aînés, CLSC, Soins à domicile"
            class="rotating-text__highlight"
          >
            Hôpitaux
          </span>
        </h2>
      </div>
    </div>
  </Fragment>
</ParallaxSection>

<script>
  import '../../../scripts/rotating-text';
</script>
