---
// Contact : coordonnées et heures d’ouverture (src/scripts/opening-hours.ts), heure de Montréal.
import OpeningHoursRow from '../../OpeningHoursRow.astro';
import { openingHours } from '../../../data/opening-hours';
import { orPlaceholder, site } from '../../../config/site';
import '../../../styles/opening-hours.css';
---

<section data-bg-section="light" data-theme-section="light" class="section">
  <div class="container">
    <div class="layout-grid grid_12-col">
      <div id="g-16" class="grid_column full-height">
        <div class="contact_info">
          <div class="contact_info-link">
            <div class="bolt"></div>
            <div class="footer_l_ink-wrap">
              <a href={site.phone.href} class="footer__link link-block">
                <span data-button-animate-chars="" class="footer__link-txt">
                  {site.phone.display}
                </span>
              </a>
              <div class="footer__link-underline"></div>
            </div>
          </div>
          <div class="max-width-40">
            <p class="text-color_white">
              Besoin de quelqu’un ce soir? Appelez-nous. Pour planifier à l’avance, écrivez-nous à{' '}
              {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : orPlaceholder(site.email, 'COURRIEL')}.
            </p>
            <p class="text-color_white">
              Siège social : {orPlaceholder(site.address, 'ADRESSE')}. Nous n’avons pas de bureau ouvert au public.
            </p>
          </div>
        </div>
      </div>
      <div id="g-17" class="grid_column">
        <div data-opening-hours-timezone="America/Toronto" data-opening-hours-init="" class="opening-hours">
          <div class="opening-hours__top">
            <h2 class="opening-hours__title">Heures d’ouverture</h2>
            <div class="opening-hours__status">
              <div class="opening-hours__status-bg"></div>
              <div class="opening-hours__status-dot"></div>
              <p class="opening-hours__p is--closed">Fermé</p>
              <p class="opening-hours__p is--open">Ouvert</p>
            </div>
          </div>
          <div class="opening-hours__timetable">
            {openingHours.map((row) => (
              <OpeningHoursRow {...row} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../../scripts/opening-hours';
</script>
