---
// Services page row: two-line heading on the left, description on the right.
import type { ServiceArea } from '../data/services';

type Props = ServiceArea;

const { titleId, textId, title, text, titleAnimate, textAnimate } = Astro.props;
---

<div class="service_item">
  <div class="layout-grid grid_12-col">
    <div id={titleId} class="grid_column">
      <h2 data-animate={titleAnimate} class="heading-size-h4">
        {title.map((line, i) => (i === 0 ? line : [<br />, line]))}
      </h2>
    </div>
    <div id={textId} class="grid_column">
      <div class="max-width-57">
        <p data-animate={textAnimate} class="text-size-medium text-color_white">
          {text}
        </p>
      </div>
    </div>
  </div>
</div>
