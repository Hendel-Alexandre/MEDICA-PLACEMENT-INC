---
import Signet from './icons/Signet.astro';
import { footerLinks, isCurrent, site } from '../config/site';

const { pathname } = Astro.url;
const onHome = isCurrent('/', pathname);
// The `g-*` ids place items in the grid (see site.css).
---

<footer data-bg-section="light" data-theme-section="light" class="footer">
  <div class="footer-layout">
    <div class="container">
      <div class="layout-grid grid_12-col">
        <a
          aria-label="Retour à l’accueil"
          id="g-01"
          href="/"
          class:list={['footer-full__logo', 'link-block', { 'w--current': onHome }]}
          aria-current={onHome ? 'page' : undefined}
        >
          <Signet />
        </a>
        <div id="g-02" class="col">
          <ul class="footer__ul">
            {footerLinks.map((link) => {
              const current = isCurrent(link.href, pathname);
              return (
                <li class="footer__li">
                  <a
                    href={link.href}
                    class:list={['footer__link', 'link-block', { 'w--current': current }]}
                    aria-current={current ? 'page' : undefined}
                  >
                    <span data-button-animate-chars="" class="footer__link-txt">
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
        <div id="g-03" class="col footer-last">
          <div class="col_contact">
            <p>
              Nous sommes là 24/7
              <br />
              <br />
              Besoin de personnel ou d’un remplacement?
              <br />
              Appelez-nous.
              <br />
              <a href={site.phone.href}>{site.phone.display}</a>
            </p>
          </div>
          <div class="bolt"></div>
        </div>
      </div>
      <div class="footer-middle">
        <div data-fit-width="" class="footer-text-display">
          Médica Placement
        </div>
      </div>
      <div class="layout-grid grid_12-col">
        <div id="g-04" class="col">
          <p class="footer-link">Votre partenaire en placement de personnel de santé au Québec</p>
        </div>
        <div id="g-05" class="col">
          <a data-button-animate-chars="" href="/confidentialite" class="footer-link">
            Confidentialité
          </a>
        </div>
        <div id="g-06" class="col footer-last">
          <a data-button-animate-chars="" href="/mentions-legales" class="footer-link">
            Mentions légales
          </a>
          <div data-current-year="" class="footer-link">
            2026
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bg">
    <div class="img-wrap">
      <img loading="lazy" src="/images/medica-footer-bg.webp" alt="" class="img-cover" />
    </div>
  </div>
</footer>
