---
// Vertical spacer. Non-default sizes add the variant class that site.css styles.
const VARIANT_CLASS = {
  main: undefined,
  xsmall: 'variant-1',
  xlarge: 'variant-2',
} as const;

interface Props {
  variant?: keyof typeof VARIANT_CLASS;
}

const { variant = 'main' } = Astro.props;
---

<div data-spacer={variant} class:list={['section_space', VARIANT_CLASS[variant]]}></div>
